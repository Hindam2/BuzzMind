<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BuzzMind · Contact</title>
  <link rel="stylesheet" href="/shared/dashboard.css" />
  <style>
    body { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 30px; }
    .contact-card { width: 100%; max-width: 540px; }
    .contact-head { text-align: center; margin-bottom: 22px; }
    .contact-head .logo { font-size: 26px; font-weight: 800; color: var(--brand-2); }
    .contact-head h1 { margin: 10px 0 6px; }
    .contact-head p { color: var(--muted); margin: 0; }
    .who { font-size: 12px; color: var(--muted); margin-top: 14px; text-align: center; }
    .who a { color: var(--blue); }
  </style>
</head>
<body>
  <div class="contact-card">
    <div class="contact-head">
      <div class="logo">BuzzMind</div>
      <h1>Get in touch</h1>
      <p>Questions, problems or feedback? Send the admin team a message.</p>
    </div>

    <div class="panel">
      <div class="form-alert" id="alert"></div>
      <form id="contactForm">
        <div class="form-row">
          <div class="field">
            <label>Name</label>
            <input type="text" id="cName" placeholder="Your name" required />
          </div>
          <div class="field">
            <label>Email</label>
            <input type="email" id="cEmail" placeholder="you@university.edu" required />
          </div>
        </div>
        <div class="field">
          <label>Subject</label>
          <input type="text" id="cSubject" placeholder="What is this about?" />
        </div>
        <div class="field">
          <label>Message</label>
          <textarea id="cBody" rows="6" placeholder="Tell us what you need…" required></textarea>
        </div>
        <div class="modal-actions" style="justify-content:space-between;align-items:center">
          <a href="/" class="muted" style="font-size:13px;text-decoration:none">&#8592; Back home</a>
          <button type="submit" class="btn btn-primary" id="sendBtn">Send message</button>
        </div>
      </form>
      <div class="who" id="who"></div>
    </div>
  </div>

  <script src="/buzzmind-api.js"></script>
  <script src="/shared/dashboard.js"></script>
  <script>
  (function () {
    let me = null;

    function setAlert(msg, type) {
      const a = document.getElementById('alert');
      a.textContent = msg || '';
      a.className = msg ? `form-alert show ${type || 'error'}` : 'form-alert';
    }

    async function init() {
      try {
        me = await BuzzMindAPI.getMe();
        if (me) {
          const n = document.getElementById('cName');
          const e = document.getElementById('cEmail');
          n.value = me.name || '';
          e.value = me.email || '';
          document.getElementById('who').innerHTML =
            `Signed in as <strong>${Dash.escapeHTML(me.name)}</strong> (${Dash.escapeHTML(me.role || 'user')}).`;
        }
      } catch (err) {
        document.getElementById('who').innerHTML = 'Not signed in? You can still send a message.';
      }
    }

    document.getElementById('contactForm').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const body = {
        name: document.getElementById('cName').value.trim(),
        email: document.getElementById('cEmail').value.trim(),
        subject: document.getElementById('cSubject').value.trim(),
        body: document.getElementById('cBody').value.trim(),
      };
      if (!body.name || !body.email || !body.body) {
        setAlert('Name, email and message are required.');
        return;
      }
      const btn = document.getElementById('sendBtn');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await BuzzMindAPI.sendContact(body);
        setAlert('Message sent! The admin team will get back to you.', 'success');
        document.getElementById('cSubject').value = '';
        document.getElementById('cBody').value = '';
      } catch (err) {
        setAlert(err.message || 'Could not send your message.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send message';
      }
    });

    init();
  })();
  </script>
</body>
</html>
