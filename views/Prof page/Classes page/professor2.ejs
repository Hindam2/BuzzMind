<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>BuzzMind – Professor Home</title>
  <link rel="stylesheet" href="/Prof page/Classes page/professor2.css"/>
</head>
<body>

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar">
  <div class="sb-logo">BuzzMind</div>

  <div class="prof-row">
  <div class="prof-av"></div>
    <div>
      <div class="prof-name">Prof. Kinetic</div>
      <div class="prof-role">PLAYGROUND ADMIN</div>
    </div>
  </div>
      <!-- Sidebar -->
  <nav class="side-nav">
    <a href="#" class="sl on"><span class="sl-ico">⊞</span> My Classes</a>
  </nav>

  <div class="sb-foot">
    <button class="btn-add" id="add-class-btn" type="button">Add New Class</button>
    <a href="/Prof page/Settings page/SettingsP.html" class="sl-sm">↪ LOGOUT</a>
  </div>
</aside>
  
<!-- ══ MAIN ══ -->
<div class="main">

  <header class="Navbar">
    <span class="tb-logo">BuzzMind</span>
    <nav class="tb-nav">
      <a href="#" class="on">My Classes</a>
    </nav>
    <div class="tb-right">
        <div class="search">
        <input type="text" placeholder="Search classes..." id="searchInput"/>
        <span></span>
      </div>
      <a href="/Prof page/Settings page/SettingsP.html" class="ico-btn"></a>
<button class="create-btn" onclick="location.href='/Prof page/QuizBuild/QuizBuild.html'">
  Create<br/>Quiz
</button>    </div>
  </header>

  <!-- Content -->
  <div class="content">

    <!-- Stats -->
    <div class="stats">
      <div class="sc">
        <div class="si si-b"></div>
      </div>
      <div class="sc">
        <div class="si si-g"></div>
        <div><div class="sn">94%</div><div class="sl2">AVG.<br/>COMPLETION</div></div>
      </div>
      <div class="sc">
        <div class="si si-p"></div>
        <div><div class="sn">1.2k</div><div class="sl2">QUIZZES<br/>TAKEN</div></div>
      </div>
      <div class="sc">
        <div class="si si-y"></div>
        <div><div class="sn">28</div><div class="sl2">TOP RANK<br/>ACHIEVED</div></div>
      </div>
    </div>

    <!-- Active Classrooms -->
    <div>
      <div class="sh">
        <div>
          <h2>Active Classrooms</h2>
          <p>Manage your currently running semesters and curricula.</p>
        </div>
      </div>

      <div class="cgrid" id="cgrid">

        <div class="cc">
          <div class="ct" style="background:linear-gradient(135deg,#0f172a,#1e1b4b)">
            <div class="ct-ov"></div><span class="lvl">LEVEL 400</span>
          </div>
          <div class="cb">
            <h3>Advanced Physics</h3>
            <p class="sch">MWF • 10:00 AM - 11:30 AM</p>
            <div class="pr"><span class="pl">COURSE PROGRESS</span><span class="pp">68%</span></div>
            <div class="pbar"><div class="pf pf-g" style="width:68%"></div></div>
            <div class="cf">
              <span class="stc">32 Students</span>
              <a href="/Prof page/classes_design/classes_page.html"><button class="mbtn" onclick="manage('Advanced Physics')">Manage</button></a>
            </div>
          </div>
        </div>

        <div class="cc">
          <div class="ct" style="background:linear-gradient(135deg,#1c1008,#3b2005)">
            <div class="ct-ov"></div><span class="lvl">LEVEL 200</span>
          </div>
          <div class="cb">
            <h3>Creative Writing</h3>
            <p class="sch">TTH • 02:00 PM - 03:30 PM</p>
            <div class="pr"><span class="pl">COURSE PROGRESS</span><span class="pp">42%</span></div>
            <div class="pbar"><div class="pf pf-g" style="width:42%"></div></div>
            <div class="cf">
              <span class="stc">18 Students</span>
              <a href="/Prof page/classes_design/classes_page.html"><button class="mbtn" onclick="manage('Creative Writing')">Manage</button></a>
            </div>
          </div>
        </div>

        <div class="cc">
          <div class="ct" style="background:linear-gradient(135deg,#0d001a,#1a0033)">
            <div class="ct-ov"></div><span class="lvl">LEVEL 500</span>
          </div>
          <div class="cb">
            <h3>Calculus BC</h3>
            <p class="sch">Daily • 08:00 AM - 09:00 AM</p>
            <div class="pr"><span class="pl">COURSE PROGRESS</span><span class="pp">85%</span></div>
            <div class="pbar"><div class="pf pf-p" style="width:85%"></div></div>
            <div class="cf">
              <span class="stc">45 Students</span>
              <a href="/Prof page/classes_design/classes_page.html"><button class="mbtn" onclick="manage('Calculus BC')">Manage</button></a>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Footer -->
    <footer class="ft">
      <span>© 2026 BuzzMind. Prof PLAYGROUND. NO BORING BITS.</span>
      </div>
    </footer>

  </div>
</div>

<div class="modal-overlay" id="class-modal" aria-hidden="true">
  <div class="class-modal" role="dialog" aria-modal="true" aria-labelledby="class-modal-title">
    <div class="modal-head">
      <div>
        <h2 id="class-modal-title">Create Class</h2>
        <p>Add a new classroom to your professor dashboard.</p>
      </div>
      <button class="modal-close" id="close-class-modal" type="button" aria-label="Close">x</button>
    </div>

    <div class="modal-field">
      <label for="class-name-input">CLASS NAME</label>
      <input id="class-name-input" type="text" placeholder="Example: Advanced Physics" />
      <p class="modal-error" id="class-name-error"></p>
    </div>

    <div class="modal-actions">
      <button class="btn-cancel" id="cancel-class-modal" type="button">Cancel</button>
      <button class="btn-create-class" id="create-class-confirm" type="button">Create Class</button>
    </div>
  </div>
</div>

<script src="/buzzmind-api.js"></script>
<script src="/buzzmind-session.js"></script>
<script src="/Prof page/Classes page/professor2.js"></script>
</body>
</html>
