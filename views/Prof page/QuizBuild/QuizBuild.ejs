<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BuzzMind – Quiz Builder</title>
    <link rel="stylesheet" href="/Prof page/QuizBuild/QuizBuild.css" />
  </head>
  <body>
    <!-- ══ SIDEBAR ══ -->
    <aside class="sidebar">
      <div class="sb-brand">BuzzMind</div>

      <nav class="side-nav">
        <a href="/Prof page/Classes page/professor2.html" class="sl"
          >My Classes</a
        >
        <a href="#" class="sl on">Quiz Builder</a>
      </nav>

      <div class="sb-bottom">
        <div class="prof-card">
          <div class="prof-av">PK</div>
          <div>
            <div class="prof-name">Prof. Kinetic</div>
            <div class="prof-role">Playground Admin</div>
          </div>
        </div>
        <a href="/Prof page/Settings page/SettingsP.html" class="sl-sm"
          >↪ Logout</a
        >
      </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <div class="main">
      <!-- Topbar -->
      <header class="topbar">
        <span class="tb-brand">BuzzMind</span>
        <nav class="tb-nav">
          <a href="/Prof page/Classes page/professor2.html">My Classes</a>
        </nav>
        <div class="tb-right">
          <a
            href="/Prof page/Settings page/SettingsP.html"
            class="icon-btn"></a>
        </div>
      </header>

      <!-- Content -->
      <div class="content">
        <!-- Page Header -->
        <div class="page-header">
          <div class="header-left">
            <span class="new-mission-badge">NEW MISSION</span>
            <h1>Create a New Quiz</h1>
            <p>Design your kinetic experience. No boring bits allowed.</p>
          </div>
          <div class="header-actions">
            <button class="btn-discard" onclick="discardDraft()">
              Discard Draft
            </button>
            <button class="btn-launch" type="button" onclick="launchQuiz()">
              Launch Quiz
            </button>
          </div>
        </div>

        <!-- Quiz Identity -->
        <div class="identity-card">
          <div class="identity-label">QUIZ IDENTITY</div>
          <input
            type="text"
            class="quiz-title-input"
            id="quizTitle"
            placeholder="Enter an epic quiz title…" />
        </div>
        <!-- Questions Container -->
        <div id="questionsContainer">
          <!-- Question 01 -->
          <div class="question-block" id="q1">
            <div class="q-header">
              <div class="q-num">01</div>
              <div class="q-actions">
                <button
                  class="q-btn"
                  onclick="deleteQuestion('q1')"
                  title="Delete">
                  Delete
                </button>
              </div>
            </div>

            <textarea
              class="q-input"
              placeholder="Write your kinetic question here…"></textarea>

            <div class="q-image">
              <img
                class="q-image-preview"
                id="q1-image"
                src=""
                alt=""
                style="
                  display: none;
                  max-width: 320px;
                  border-radius: 8px;
                  margin-top: 0.6rem;
                " />
              <div class="q-image-controls" style="margin-top: 0.4rem">
                <input
                  type="file"
                  accept="image/*"
                  onchange="handleImageChange(this, 'q1')" />
                <button
                  type="button"
                  class="btn-remove-image"
                  onclick="removeImage('q1')"
                  style="display: none; margin-left: 0.5rem">
                  Remove Image
                </button>
              </div>
            </div>

            <div class="choices-grid">
              <div class="choice red">
                <span class="choice-letter">A</span>
                <input
                  type="text"
                  value="The velocity of the particle increases"
                  class="choice-input" />
                <button
                  class="choice-radio"
                  onclick="selectAnswer(this)"></button>
              </div>
              <div class="choice green selected">
                <span class="choice-letter">B</span>
                <input
                  type="text"
                  value="Gravity remains a constant variable"
                  class="choice-input" />
                <button
                  class="choice-radio correct"
                  onclick="selectAnswer(this)"></button>
              </div>
              <div class="choice yellow">
                <span class="choice-letter">C</span>
                <input
                  type="text"
                  placeholder="Add answer choice…"
                  class="choice-input" />
                <button
                  class="choice-radio"
                  onclick="selectAnswer(this)"></button>
              </div>
              <div class="choice blue">
                <span class="choice-letter">D</span>
                <input
                  type="text"
                  placeholder="Add answer choice…"
                  class="choice-input" />
                <button
                  class="choice-radio"
                  onclick="selectAnswer(this)"></button>
              </div>
            </div>
          </div>

          <!-- Question 02 – Empty placeholder -->
          <div class="question-block empty-block" id="q2">
            <div class="q-header">
              <div class="q-num muted">02</div>
              <div class="q-actions">
                <button
                  class="q-btn"
                  onclick="deleteQuestion('q2')"
                  title="Delete">
                  Delete
                </button>
              </div>
            </div>
            <div class="empty-body">
              <button class="add-q-circle" onclick="activateQuestion('q2')">
                ＋
              </button>
              <h3>Next Question</h3>
              <p>Keep the momentum going with another interactive block.</p>
              <button class="btn-add-q" onclick="activateQuestion('q2')">
                Add Question Block
              </button>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <footer class="ft">
          <span>© 2024 BuzzMind Kinetic Playground. No boring bits.</span>
        </footer>
      </div>
    </div>

    <script src="/buzzmind-api.js"></script>
    <script src="/buzzmind-session.js"></script>
    <script src="/Prof page/QuizBuild/QuizBuild.js"></script>
  </body>
</html>
